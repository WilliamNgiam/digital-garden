filters:
  and:
    - file.tags.contains("#project")
views:
  - type: cards
    name: Cards
    order:
      - file.name
      - project_status
      - code_repo
      - data_repo
      - paper_doi
      - preprint
    cardSize: 400
    imageAspectRatio: 0.4
  - type: table
    name: Table
    order:
      - file.name
      - project_status
      - aliases
      - project_name
      - lab_members
      - collaborator(s)
      - prereg
      - prereg_url
      - open_code
      - code_repo
      - open_data
      - data_repo
      - published
      - paper_doi
      - paper_journal
      - concept(s)
      - updated
    sort: []
    rowHeight: medium
